# CleanConnect environment variables — placeholders only, no real values.
# Supabase project: blgyguiwnbmmlbsjrzqg (https://blgyguiwnbmmlbsjrzqg.supabase.co)

# --- Used locally (Vite build) and safe to expose to the browser ---
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_URL=https://your_supabase_project_id.supabase.co
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
VITE_SUPABASE_URL=https://your_supabase_project_id.supabase.co

# --- Netlify-only, server-side secrets. Set these in Netlify's dashboard
#     (Site settings -> Environment variables), NEVER in a committed .env
#     or in any frontend-bundled variable (no VITE_ prefix). ---

# Required for role-provisioning server functions and all admin/service-role
# database operations (matching engine, webhook, scheduled job).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Required for Paystack payment initialization, verification, and webhook
# signature validation. Use TEST MODE keys (sk_test_..., pk_test_...) until
# a full test-mode transaction has been verified end to end — do not switch
# to live keys before that.
PAYSTACK_SECRET_KEY=your_paystack_secret_key
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Webhook URL to configure in the Paystack dashboard (Settings -> API Keys
# & Webhooks): https://YOUR-NETLIFY-DOMAIN/api/paystack-webhook
